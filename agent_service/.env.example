# Defaults are local demonstration mode, using explicitly synthetic fixtures.
AGENT_PROVIDER=demo
# Set compatible for API, or codex for LOCAL official CLI account login.
MODEL_BASE_URL=
MODEL_NAME=
MODEL_API_KEY=
# Protect HTTP requests when deployed beyond localhost.
AGENT_API_TOKEN=
# Deployment-owned folder containing AGENTS.md and skills/*/SKILL.md.
# AGENT_PROFILE_DIR=D:/cst_proj/agent_service/profiles/default
# Optional curated SQLite snapshot, opened read-only. Never import credential tables.
# AGENT_BUSINESS_DB=
# Local curated snapshot config generated by ad_agent.prepare_data (never commit it).
# AGENT_LOCAL_DATA_CONFIG=D:/cst_proj/agent_service/var/local-data.json
# Optional deployment-owned, scoped recent view/alert JSON export; keep under var/.
# AGENT_CUSTOMER_CONTEXT_FILE=D:/cst_proj/agent_service/var/customer_context.json


# 未明确规定的历史限制参数；不是当前会话的请求次数阈值
HANDOFF_HISTORY_DAYS=30
HANDOFF_HISTORY_LIMIT=3
